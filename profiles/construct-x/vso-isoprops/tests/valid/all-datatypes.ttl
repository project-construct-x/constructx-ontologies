@prefix conx-vso: <https://www.construct-x.org/ontology/vso#> .
@prefix ex: <https://example.org/id/> .
@prefix isoprops: <https://w3id.org/isoprops#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:resource
  conx-vso:hasProperty ex:boolean-assignment,
                       ex:integer-assignment,
                       ex:rational-assignment,
                       ex:real-assignment,
                       ex:complex-assignment,
                       ex:string-assignment,
                       ex:datetime-assignment ;
.

ex:boolean-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:boolean-definition ; conx-vso:hasPropertyState ex:boolean-state .
ex:boolean-state a conx-vso:PropertyState ; schema:value true ; conx-vso:hasUsedUnit unit:UNITLESS .
ex:boolean-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000001" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "active" ; isoprops:dataType "BOOLEAN" ; isoprops:hasUnit unit:UNITLESS .

ex:integer-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:integer-definition ; conx-vso:hasPropertyState ex:integer-state .
ex:integer-state a conx-vso:PropertyState ; schema:value "12"^^xsd:int ; conx-vso:hasUsedUnit unit:UNITLESS .
ex:integer-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000002" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "active" ; isoprops:dataType "INTEGER" ; isoprops:hasUnit unit:UNITLESS .

ex:rational-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:rational-definition ; conx-vso:hasPropertyState ex:rational-state .
ex:rational-state a conx-vso:PropertyState ; schema:value "0.5"^^xsd:decimal ; conx-vso:hasUsedUnit unit:UNITLESS .
ex:rational-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000003" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "active" ; isoprops:dataType "RATIONAL" ; isoprops:hasUnit unit:UNITLESS .

ex:real-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:real-definition ; conx-vso:hasPropertyState ex:real-state .
ex:real-state a conx-vso:PropertyState ; schema:value "2.8"^^xsd:double ; conx-vso:hasUsedUnit unit:M .
ex:real-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000004" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "active" ; isoprops:dataType "REAL" ; isoprops:hasUnit unit:M .

ex:complex-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:complex-definition ; conx-vso:hasPropertyState ex:complex-state .
ex:complex-state a conx-vso:PropertyState ; schema:value "3+4i" ; conx-vso:hasUsedUnit unit:UNITLESS .
ex:complex-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000005" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "active" ; isoprops:dataType "COMPLEX" ; isoprops:hasUnit unit:UNITLESS .

ex:string-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:string-definition ; conx-vso:hasPropertyState ex:string-state .
ex:string-state a conx-vso:PropertyState ; schema:value "Beispiel"@de ; conx-vso:hasUsedUnit unit:UNITLESS .
ex:string-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000006" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "inactive" ; isoprops:dataType "STRING" ; isoprops:hasUnit unit:UNITLESS .

ex:datetime-assignment a conx-vso:AssignedProperty ; conx-vso:hasPropertyReference ex:datetime-definition ; conx-vso:hasPropertyState ex:datetime-state .
ex:datetime-state a conx-vso:PropertyState ; schema:value "2026-09-01T10:30:00Z"^^xsd:dateTime ; conx-vso:hasUsedUnit unit:UNITLESS .
ex:datetime-definition a isoprops:Property ; isoprops:globallyUniqueIdentifier "00000000-0000-4000-8000-000000000007" ; isoprops:versionNumber 1 ; isoprops:revisionNumber 1 ; isoprops:status "active" ; isoprops:dataType "DATETIME" ; isoprops:hasUnit unit:UNITLESS .

unit:M a qudt:Unit .
unit:UNITLESS a qudt:Unit .
