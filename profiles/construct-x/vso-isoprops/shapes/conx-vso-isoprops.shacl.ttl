# baseURI: https://www.construct-x.org/shapes/vso/isoprops
# prefix: conx-vso-isoprops-sh

@prefix conx-vso: <https://www.construct-x.org/ontology/vso#> .
@prefix conx-vso-isoprops-sh: <https://www.construct-x.org/shapes/vso/isoprops#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isoprops: <https://w3id.org/isoprops#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.construct-x.org/shapes/vso/isoprops>
  a owl:Ontology ;
  dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
  dcterms:created "2026-09-01"^^xsd:date ;
  dcterms:modified "2026-11-11"^^xsd:date ;
  dcterms:description "ISOProps-v2.2-Profil für Merkmalszuweisungen der Construct-X Value Semantics Ontology."@de ;
  dcterms:description "ISOProps v2.2 profile for property assignments of the Construct-X Value Semantics Ontology."@en ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:publisher <https://www.construct-x.org/id/organization/ecbe8336-94ab-5c11-8220-94f260963eb2/revision/1> ;
  dcterms:source <https://w3id.org/isoprops> ;
  dcterms:title "Construction-X VSO ISOProps Profile Shapes"@de ;
  dcterms:title "Construction-X VSO ISOProps Profile Shapes"@en ;
  owl:versionIRI <https://www.construct-x.org/shapes/vso/isoprops/0.1.0> ;
  owl:versionInfo "0.1.0" ;
.

## Assignment and definition shapes

conx-vso-isoprops-sh:ISOPropsAssignmentShape
  a sh:NodeShape ;
  sh:name "VSO-Merkmalszuweisung mit ISOProps-Referenz"@de ;
  sh:name "VSO assignment with ISOProps reference"@en ;
  sh:targetClass conx-vso:AssignedProperty ;
  sh:targetSubjectsOf conx-vso:hasPropertyReference ;
  sh:property conx-vso-isoprops-sh:ISOPropsReferencePropertyShape,
              conx-vso-isoprops-sh:ISOPropsUsedUnitPropertyShape,
              conx-vso-isoprops-sh:LiteralValuePropertyShape ;
  sh:sparql conx-vso-isoprops-sh:UsedUnitAllowedConstraint,
             conx-vso-isoprops-sh:ValueDatatypeConstraint ;
.

conx-vso-isoprops-sh:ISOPropsPropertyShape
  a sh:NodeShape ;
  sh:class isoprops:Property ;
  sh:name "ISOProps-Merkmalsdefinition"@de ;
  sh:name "ISOProps property definition"@en ;
  sh:targetClass isoprops:Property ;
  sh:property conx-vso-isoprops-sh:GuidPropertyShape,
              conx-vso-isoprops-sh:VersionNumberPropertyShape,
              conx-vso-isoprops-sh:RevisionNumberPropertyShape,
              conx-vso-isoprops-sh:StatusPropertyShape,
              conx-vso-isoprops-sh:DataTypePropertyShape,
              conx-vso-isoprops-sh:AllowedUnitPropertyShape ;
  sh:sparql conx-vso-isoprops-sh:ConstructXRevisionIriConstraint,
             conx-vso-isoprops-sh:ConstructXIdentityConsistencyConstraint ;
.

## Assignment property shapes

conx-vso-isoprops-sh:ISOPropsReferencePropertyShape
  a sh:PropertyShape ;
  sh:path conx-vso:hasPropertyReference ;
  sh:class isoprops:Property ;
  sh:nodeKind sh:IRI ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:message "[ISOP-REF-001] Jede Zuweisung muss genau eine per IRI referenzierte ISOProps-Merkmalsdefinition besitzen."@de ;
  sh:message "[ISOP-REF-001] Every assignment must reference exactly one IRI-valued ISOProps property definition."@en ;
.

conx-vso-isoprops-sh:ISOPropsUsedUnitPropertyShape
  a sh:PropertyShape ;
  sh:path ( conx-vso:hasPropertyState conx-vso:hasUsedUnit ) ;
  sh:class qudt:Unit ;
  sh:nodeKind sh:IRI ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:message "[ISOP-ASSIGN-UNIT-001] Im ISOProps-Profil muss der Zustand genau eine per IRI referenzierte QUDT-Einheit verwenden."@de ;
  sh:message "[ISOP-ASSIGN-UNIT-001] In the ISOProps profile, the state must use exactly one IRI-referenced QUDT unit."@en ;
.

# Check actual literal values, not just DATATYPE(?value). Datatype validation
# includes integer bounds; lexical patterns prevent permissive conversions.
conx-vso-isoprops-sh:LiteralValuePropertyShape a sh:PropertyShape ;
  sh:path ( conx-vso:hasPropertyState schema:value ) ;
  sh:nodeKind sh:Literal ;
  sh:or (
    [ sh:datatype xsd:boolean ; sh:pattern "^(true|false|0|1)$" ]
    [ sh:datatype xsd:integer ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:nonPositiveInteger ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:negativeInteger ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:long ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:int ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:short ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:byte ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:nonNegativeInteger ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:unsignedLong ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:unsignedInt ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:unsignedShort ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:unsignedByte ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:positiveInteger ; sh:pattern "^[+-]?[0-9]+$" ]
    [ sh:datatype xsd:decimal ; sh:pattern "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$" ]
    [ sh:datatype xsd:float ; sh:pattern "^([+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?|[+-]?INF|NaN)$" ]
    [ sh:datatype xsd:double ; sh:pattern "^([+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?|[+-]?INF|NaN)$" ]
    [ sh:datatype xsd:dateTime ; sh:pattern "^-?([0-9]{4}|[1-9][0-9]{4,})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?|24:00:00([.]0+)?)(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?$" ]
    [ sh:datatype xsd:string ]
    [ sh:datatype rdf:langString ]
    conx-vso-isoprops-sh:OpaqueLiteralShape
  ) ;
  sh:message "[ISOP-VALUE-002] A mapped literal must have a valid lexical form and satisfy its datatype's value bounds."@en,
             "[ISOP-VALUE-002] Ein abgebildeter Literalwert muss eine gültige Schreibweise und den Wertebereich seines Datentyps besitzen."@de .

# COMPLEX remains open to literals of other, application-defined datatypes.
# Known mapped datatypes must never escape validation through this branch.
conx-vso-isoprops-sh:OpaqueLiteralShape a sh:NodeShape ;
  sh:nodeKind sh:Literal ;
  sh:sparql conx-vso-isoprops-sh:OpaqueDatatypeConstraint .

conx-vso-isoprops-sh:OpaqueDatatypeConstraint a sh:SPARQLConstraint ;
  sh:message "[ISOP-VALUE-002] Known mapped datatypes must pass their literal validation branch."@en,
             "[ISOP-VALUE-002] Bekannte abgebildete Datentypen müssen ihre Literalprüfung bestehen."@de ;
  sh:select """
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    SELECT $this WHERE {
      FILTER (DATATYPE($this) IN (
        xsd:boolean, xsd:integer, xsd:nonPositiveInteger, xsd:negativeInteger, xsd:long, xsd:int, xsd:short, xsd:byte, xsd:nonNegativeInteger, xsd:unsignedLong, xsd:unsignedInt, xsd:unsignedShort, xsd:unsignedByte, xsd:positiveInteger, xsd:decimal, xsd:float, xsd:double, xsd:dateTime, xsd:string, rdf:langString
      ))
    }
  """ .

## ISOProps definition property shapes

conx-vso-isoprops-sh:GuidPropertyShape
  a sh:PropertyShape ;
  sh:path isoprops:globallyUniqueIdentifier ;
  sh:datatype xsd:string ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" ;
  sh:message "[ISOP-ID-001] Eine ISOProps-Merkmalsdefinition muss genau eine gültige UUID als GUID besitzen."@de ;
  sh:message "[ISOP-ID-001] An ISOProps property definition must have exactly one valid UUID GUID."@en ;
.

conx-vso-isoprops-sh:VersionNumberPropertyShape
  a sh:PropertyShape ;
  sh:path isoprops:versionNumber ;
  sh:datatype xsd:integer ;
  sh:minInclusive 1 ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:message "[ISOP-VERSION-001] Eine ISOProps-Merkmalsdefinition muss genau eine positive ganzzahlige Versionsnummer besitzen."@de ;
  sh:message "[ISOP-VERSION-001] An ISOProps property definition must have exactly one positive integer version number."@en ;
.

conx-vso-isoprops-sh:RevisionNumberPropertyShape
  a sh:PropertyShape ;
  sh:path isoprops:revisionNumber ;
  sh:datatype xsd:integer ;
  sh:minInclusive 1 ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:message "[ISOP-REVISION-001] Eine ISOProps-Merkmalsdefinition muss genau eine positive ganzzahlige Revisionsnummer besitzen."@de ;
  sh:message "[ISOP-REVISION-001] An ISOProps property definition must have exactly one positive integer revision number."@en ;
.

conx-vso-isoprops-sh:StatusPropertyShape
  a sh:PropertyShape ;
  sh:path isoprops:status ;
  sh:datatype xsd:string ;
  sh:in ( "active" "inactive" ) ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:message "[ISOP-STATUS-001] Der ISOProps-Status muss genau einmal als active oder inactive angegeben werden."@de ;
  sh:message "[ISOP-STATUS-001] The ISOProps status must occur exactly once with value active or inactive."@en ;
.

conx-vso-isoprops-sh:DataTypePropertyShape
  a sh:PropertyShape ;
  sh:path isoprops:dataType ;
  sh:datatype xsd:string ;
  sh:in ( "BOOLEAN" "INTEGER" "RATIONAL" "REAL" "COMPLEX" "STRING" "DATETIME" ) ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:message "[ISOP-DATATYPE-001] Der ISOProps-Datentyp muss genau einmal mit einem in v2.2 definierten Wert angegeben werden."@de ;
  sh:message "[ISOP-DATATYPE-001] The ISOProps datatype must occur exactly once with a value defined by v2.2."@en ;
.

conx-vso-isoprops-sh:AllowedUnitPropertyShape
  a sh:PropertyShape ;
  sh:path isoprops:hasUnit ;
  sh:class qudt:Unit ;
  sh:nodeKind sh:IRI ;
  sh:minCount 1 ;
  sh:message "[ISOP-UNIT-001] Eine ISOProps-Merkmalsdefinition muss mindestens eine per IRI referenzierte QUDT-Einheit erlauben."@de ;
  sh:message "[ISOP-UNIT-001] An ISOProps property definition must allow at least one IRI-referenced QUDT unit."@en ;
.

## SPARQL constraints

conx-vso-isoprops-sh:ConstructXRevisionIriConstraint
  a sh:SPARQLConstraint ;
  sh:message "[ISOP-ID-002] Eine von Construct-X verwaltete Merkmalsdefinition muss eine exakte /id/property/{guid}/revision/{revision}-IRI verwenden."@de ;
  sh:message "[ISOP-ID-002] A Construct-X managed property definition must use an exact /id/property/{guid}/revision/{revision} IRI."@en ;
  sh:select """
    SELECT $this
    WHERE {
      $this a <https://w3id.org/isoprops#Property> .
      FILTER(STRSTARTS(STR($this), "https://www.construct-x.org/id/property/"))
      FILTER(!REGEX(
        STR($this),
        "^https://www[.]construct-x[.]org/id/property/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/revision/[1-9][0-9]*$",
        "i"
      ))
    }
  """ ;
.

conx-vso-isoprops-sh:ConstructXIdentityConsistencyConstraint
  a sh:SPARQLConstraint ;
  sh:message "[ISOP-ID-003] GUID oder Revisionsnummer der Construct-X-IRI stimmt nicht mit den ISOProps-Metadaten überein."@de ;
  sh:message "[ISOP-ID-003] The GUID or revision number in the Construct-X IRI does not match the ISOProps metadata."@en ;
  sh:select """
    PREFIX isoprops: <https://w3id.org/isoprops#>
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    SELECT $this
    WHERE {
      $this isoprops:globallyUniqueIdentifier ?guid ;
            isoprops:revisionNumber ?revision .
      FILTER(REGEX(
        STR($this),
        "^https://www[.]construct-x[.]org/id/property/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/revision/[1-9][0-9]*$",
        "i"
      ))
      BIND(REPLACE(
        STR($this),
        "^https://www[.]construct-x[.]org/id/property/([0-9a-f-]+)/revision/[1-9][0-9]*$",
        "$1",
        "i"
      ) AS ?iriGuid)
      BIND(REPLACE(STR($this), "^.*/revision/([1-9][0-9]*)$", "$1") AS ?iriRevision)
      FILTER(
        LCASE(STR(?guid)) != LCASE(?iriGuid) ||
        ?revision != xsd:integer(?iriRevision)
      )
    }
  """ ;
.

conx-vso-isoprops-sh:UsedUnitAllowedConstraint
  a sh:SPARQLConstraint ;
  sh:message "[ISOP-ASSIGN-UNIT-002] Die verwendete Einheit ist für die referenzierte ISOProps-Merkmalsdefinition nicht zugelassen."@de ;
  sh:message "[ISOP-ASSIGN-UNIT-002] The used unit is not allowed by the referenced ISOProps property definition."@en ;
  sh:select """
    PREFIX conx-vso: <https://www.construct-x.org/ontology/vso#>
    PREFIX isoprops: <https://w3id.org/isoprops#>
    SELECT $this ?usedUnit
    WHERE {
      $this conx-vso:hasPropertyReference ?definition ;
            conx-vso:hasPropertyState ?state .
      ?state conx-vso:hasUsedUnit ?usedUnit .
      FILTER NOT EXISTS { ?definition isoprops:hasUnit ?usedUnit }
    }
  """ ;
.

conx-vso-isoprops-sh:ValueDatatypeConstraint
  a sh:SPARQLConstraint ;
  sh:message "[ISOP-VALUE-001] schema:value entspricht nicht der konservativen RDF-Abbildung des ISOProps-Datentyps."@de ;
  sh:message "[ISOP-VALUE-001] schema:value does not match the conservative RDF mapping of the ISOProps datatype."@en ;
  sh:select """
    PREFIX conx-vso: <https://www.construct-x.org/ontology/vso#>
    PREFIX isoprops: <https://w3id.org/isoprops#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX schema: <https://schema.org/>
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    SELECT $this ?value ?declaredType
    WHERE {
      $this conx-vso:hasPropertyReference ?definition ;
            conx-vso:hasPropertyState ?state .
      ?definition isoprops:dataType ?declaredType .
      ?state schema:value ?value .
      BIND(STR(?declaredType) AS ?declared)
      BIND(IF(isLiteral(?value), DATATYPE(?value), <urn:construct-x:not-a-literal>) AS ?valueDatatype)
      FILTER(
        (?declared = "BOOLEAN" && ?valueDatatype != xsd:boolean) ||
        (?declared = "INTEGER" && ?valueDatatype NOT IN (
          xsd:integer, xsd:nonPositiveInteger, xsd:negativeInteger,
          xsd:long, xsd:int, xsd:short, xsd:byte,
          xsd:nonNegativeInteger, xsd:unsignedLong, xsd:unsignedInt,
          xsd:unsignedShort, xsd:unsignedByte, xsd:positiveInteger
        )) ||
        (?declared IN ("RATIONAL", "REAL") && ?valueDatatype NOT IN (
          xsd:decimal, xsd:double, xsd:float,
          xsd:integer, xsd:nonPositiveInteger, xsd:negativeInteger,
          xsd:long, xsd:int, xsd:short, xsd:byte,
          xsd:nonNegativeInteger, xsd:unsignedLong, xsd:unsignedInt,
          xsd:unsignedShort, xsd:unsignedByte, xsd:positiveInteger
        )) ||
        (?declared = "COMPLEX" && !isLiteral(?value)) ||
        (?declared = "STRING" && ?valueDatatype NOT IN (xsd:string, rdf:langString)) ||
        (?declared = "DATETIME" && ?valueDatatype != xsd:dateTime)
      )
    }
  """ ;
.
