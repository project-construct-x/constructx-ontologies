  sh:property [
      sh:path conx-contact:contactURI ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
      sh:nodeKind sh:IRI ;
      sh:message "[CON-CM-031] contactURI muss eine IRI sein, wenn der Kanal eine URI verlangt."@de ;
      sh:message "[CON-CM-031] contactURI must be an IRI when the channel requires a URI."@en ;
    ] ;
  sh:property [
      sh:path conx-contact:contactValue ;
      sh:maxCount 0 ;
      sh:message "[CON-CM-020] Eine Messenger-Kontaktmethode darf nicht gleichzeitig contactURI und contactValue besitzen."@de ;
      sh:message "[CON-CM-020] A messenger contact method must not have both contactURI and contactValue."@en ;
    ] ;
  sh:property [
      sh:path conx-contact:usesLocationAssignment ;
