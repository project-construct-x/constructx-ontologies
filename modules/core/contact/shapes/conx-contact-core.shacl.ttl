      sh:message "[CON-CM-020] Eine Messenger-Kontaktmethode darf keine Standortzuordnung besitzen."@de ;
      sh:message "[CON-CM-020] A messenger contact method must not have a location assignment."@en ;
    ] ;
.

conx-contact-sh:PostalAddressPayloadShape
  a sh:NodeShape ;
