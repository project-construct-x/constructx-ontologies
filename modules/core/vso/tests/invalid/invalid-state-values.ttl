@prefix conx-vso: <https://www.construct-x.org/ontology/vso#> .
@prefix ex: <https://example.org/id/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix schema: <https://schema.org/> .

ex:resource conx-vso:hasProperty ex:assignment .

ex:assignment
  a conx-vso:AssignedProperty ;
  conx-vso:hasPropertyReference ex:property-definition ;
  conx-vso:hasPropertyState ex:state ;
.

ex:state
  a conx-vso:PropertyState ;
  schema:value "first",
               "second" ;
  conx-vso:hasUsedUnit ex:first-unit,
                       ex:second-unit ;
.

ex:first-unit a qudt:Unit .
ex:second-unit a qudt:Unit .
