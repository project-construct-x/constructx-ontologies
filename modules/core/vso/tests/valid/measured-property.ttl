@prefix conx-vso: <https://www.construct-x.org/ontology/vso#> .
@prefix ex: <https://example.org/id/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:wall
  conx-vso:hasProperty ex:height-assignment ;
.

ex:height-assignment
  a conx-vso:AssignedProperty ;
  conx-vso:hasPropertyReference ex:height-definition ;
  conx-vso:hasPropertyState ex:height-state ;
.

ex:height-state
  a conx-vso:PropertyState ;
  schema:value "2.80"^^xsd:decimal ;
  conx-vso:hasUsedUnit unit:M ;
.

unit:M a qudt:Unit .
