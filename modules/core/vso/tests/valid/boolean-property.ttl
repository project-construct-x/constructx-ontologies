@prefix conx-vso: <https://www.construct-x.org/ontology/vso#> .
@prefix ex: <https://example.org/id/> .
@prefix schema: <https://schema.org/> .

ex:component
  conx-vso:hasProperty ex:recyclable-assignment ;
.

ex:recyclable-assignment
  a conx-vso:AssignedProperty ;
  conx-vso:hasPropertyReference ex:recyclable-definition ;
  conx-vso:hasPropertyState ex:recyclable-state ;
.

ex:recyclable-state
  a conx-vso:PropertyState ;
  schema:value true ;
.
