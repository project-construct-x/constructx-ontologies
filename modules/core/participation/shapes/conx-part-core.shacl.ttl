# baseURI: https://www.construct-x.org/shapes/participation/core
# prefix: conx-part-sh

@prefix conx-agent: <https://www.construct-x.org/ontology/agent#> .
@prefix conx-part: <https://www.construct-x.org/ontology/participation#> .
@prefix conx-part-sh: <https://www.construct-x.org/shapes/participation/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.construct-x.org/shapes/participation/core>
  a owl:Ontology ;
  dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
  dcterms:created "2026-08-27"^^xsd:date ;
  dcterms:creator [
      a schema:Person ;
      schema:email <mailto:sven.zentgraf@rub.de> ;
      schema:identifier <https://orcid.org/0000-0001-6058-7614> ;
      schema:memberOf [
          schema:identifier <https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/sven_zentgraf.html.en> ;
          schema:name "Ruhr University Bochum" ;
        ] ;
      schema:name "Sven Zentgraf" ;
    ] ;
  dcterms:description "Validierungsregeln fuer die allgemeinen, anwendungsfallunabhaengigen Vertraege der Construct-X Participation-Ontologie."@de ;
  dcterms:description "Validation rules for the general, application-independent contracts of the Construct-X Participation Ontology."@en ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:modified "2026-11-19"^^xsd:date ;
  dcterms:publisher <https://www.construct-x.org/id/organization/ecbe8336-94ab-5c11-8220-94f260963eb2/revision/1> ;
  dcterms:title "Construct-X Participation Core Shapes"@de ;
  dcterms:title "Construct-X Participation Core Shapes"@en ;
  owl:versionIRI <https://www.construct-x.org/shapes/participation/core/0.3.0> ;
  owl:versionInfo "0.3.0" ;
.

## Participation target and node contracts

conx-part-sh:ParticipationIriShape
  a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:severity sh:Violation ;
  sh:message "[PART-001] Eine Participation muss durch eine IRI referenziert werden."@de ;
  sh:message "[PART-001] A Participation must be referenced by an IRI."@en ;
.

conx-part-sh:ExplicitParticipationTypeShape
  a sh:NodeShape ;
  sh:class conx-part:Participation ;
  sh:severity sh:Violation ;
  sh:message "[PART-002] Eine Ressource mit Participation-Properties muss explizit als conx-part:Participation typisiert sein."@de ;
  sh:message "[PART-002] A resource using Participation properties must be explicitly typed as conx-part:Participation."@en ;
.

conx-part-sh:ParticipationShape
  a sh:NodeShape ;
  sh:name "Beteiligung"@de ;
  sh:name "Participation"@en ;
  sh:targetClass conx-part:Participation ;
  sh:targetSubjectsOf conx-part:hasParticipant,
                      conx-part:hasRole,
                      conx-part:hasContext,
                      conx-part:startDate,
                      conx-part:endDate ;
  sh:node conx-part-sh:ParticipationIriShape,
          conx-part-sh:ExplicitParticipationTypeShape ;
  sh:property conx-part-sh:ParticipantMinCountPropertyShape,
              conx-part-sh:ParticipantMaxCountPropertyShape,
              conx-part-sh:ParticipantIriPropertyShape,
              conx-part-sh:ParticipantAgentTypePropertyShape,
              conx-part-sh:RoleMinCountPropertyShape,
              conx-part-sh:RoleMaxCountPropertyShape,
              conx-part-sh:RoleIriPropertyShape,
              conx-part-sh:RoleTypePropertyShape,
              conx-part-sh:ContextMinCountPropertyShape,
              conx-part-sh:ContextMaxCountPropertyShape,
              conx-part-sh:ContextResourcePropertyShape,
              conx-part-sh:StartDateMaxCountPropertyShape,
              conx-part-sh:StartDateDatatypePropertyShape,
              conx-part-sh:EndDateMaxCountPropertyShape,
              conx-part-sh:EndDateDatatypePropertyShape,
              conx-part-sh:DateOrderPropertyShape ;
  sh:sparql [
      a sh:SPARQLConstraint ;
      sh:severity sh:Violation ;
      sh:select """
        SELECT DISTINCT $this
        WHERE {
          $this <https://www.construct-x.org/ontology/participation#hasParticipant> ?agent ;
                <https://www.construct-x.org/ontology/participation#hasRole> ?role ;
                <https://www.construct-x.org/ontology/participation#hasContext> ?context .
          ?other a <https://www.construct-x.org/ontology/participation#Participation> ;
                 <https://www.construct-x.org/ontology/participation#hasParticipant> ?agent ;
                 <https://www.construct-x.org/ontology/participation#hasRole> ?role ;
                 <https://www.construct-x.org/ontology/participation#hasContext> ?context .
          FILTER (?other != $this)
          FILTER (STR(?other) < STR($this))
        }
      """ ;
      sh:message "[PART-050] Eine zweite Participation mit derselben Kombination aus hasParticipant, hasRole und hasContext ist nicht zulaessig."@de ;
      sh:message "[PART-050] A second Participation with the same combination of hasParticipant, hasRole, and hasContext is not allowed."@en ;
    ] ;
.

## Participant property contracts

conx-part-sh:ParticipantMinCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasParticipant ;
  sh:minCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-010] Eine Participation muss genau einen Wert fuer hasParticipant besitzen."@de ;
  sh:message "[PART-010] A Participation must have exactly one participant."@en ;
.

conx-part-sh:ParticipantMaxCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasParticipant ;
  sh:maxCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-011] Eine Participation darf hoechstens einen Wert fuer hasParticipant besitzen."@de ;
  sh:message "[PART-011] A Participation must have at most one participant."@en ;
.

conx-part-sh:ParticipantIriPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasParticipant ;
  sh:nodeKind sh:IRI ;
  sh:severity sh:Violation ;
  sh:message "[PART-012] hasParticipant muss auf eine IRI verweisen."@de ;
  sh:message "[PART-012] hasParticipant must refer to an IRI."@en ;
.

conx-part-sh:ParticipantAgentTypePropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasParticipant ;
  sh:class conx-agent:Agent ;
  sh:severity sh:Violation ;
  sh:message "[PART-013] hasParticipant muss als conx-agent:Agent oder bekannte Unterklasse typisiert sein."@de ;
  sh:message "[PART-013] hasParticipant must be typed as conx-agent:Agent or a known subclass."@en ;
.

## Role property contracts

conx-part-sh:RoleMinCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasRole ;
  sh:minCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-020] Eine Participation muss genau einen Wert fuer hasRole besitzen."@de ;
  sh:message "[PART-020] A Participation must have exactly one role."@en ;
.

conx-part-sh:RoleMaxCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasRole ;
  sh:maxCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-021] Eine Participation darf hoechstens einen Wert fuer hasRole besitzen."@de ;
  sh:message "[PART-021] A Participation must have at most one role."@en ;
.

conx-part-sh:RoleIriPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasRole ;
  sh:nodeKind sh:IRI ;
  sh:severity sh:Violation ;
  sh:message "[PART-022] hasRole muss auf eine IRI verweisen."@de ;
  sh:message "[PART-022] hasRole must refer to an IRI."@en ;
.

conx-part-sh:RoleTypePropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasRole ;
  sh:class conx-part:Role ;
  sh:severity sh:Violation ;
  sh:message "[PART-023] hasRole muss explizit als conx-part:Role typisiert sein; skos:Concept allein reicht nicht."@de ;
  sh:message "[PART-023] hasRole must be explicitly typed as conx-part:Role; skos:Concept alone is insufficient."@en ;
.

## Context property contracts

conx-part-sh:ContextMinCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasContext ;
  sh:minCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-030] Eine Participation muss genau einen Wert fuer hasContext besitzen."@de ;
  sh:message "[PART-030] A Participation must have exactly one context."@en ;
.

conx-part-sh:ContextMaxCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasContext ;
  sh:maxCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-031] Eine Participation darf hoechstens einen Wert fuer hasContext besitzen."@de ;
  sh:message "[PART-031] A Participation must have at most one context."@en ;
.

conx-part-sh:ContextResourcePropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:hasContext ;
  sh:nodeKind sh:BlankNodeOrIRI ;
  sh:severity sh:Violation ;
  sh:message "[PART-032] hasContext muss auf eine IRI oder einen Blank Node verweisen."@de ;
  sh:message "[PART-032] hasContext must refer to an IRI or blank node."@en ;
.

## Temporal property contracts

conx-part-sh:StartDateMaxCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:startDate ;
  sh:maxCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-040] startDate darf hoechstens einmal vorkommen."@de ;
  sh:message "[PART-040] startDate must occur at most once."@en ;
.

conx-part-sh:StartDateDatatypePropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:startDate ;
  sh:datatype xsd:date ;
  sh:severity sh:Violation ;
  sh:message "[PART-041] startDate muss ein xsd:date sein."@de ;
  sh:message "[PART-041] startDate must be an xsd:date."@en ;
.

conx-part-sh:EndDateMaxCountPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:endDate ;
  sh:maxCount 1 ;
  sh:severity sh:Violation ;
  sh:message "[PART-042] endDate darf hoechstens einmal vorkommen."@de ;
  sh:message "[PART-042] endDate must occur at most once."@en ;
.

conx-part-sh:EndDateDatatypePropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:endDate ;
  sh:datatype xsd:date ;
  sh:severity sh:Violation ;
  sh:message "[PART-043] endDate muss ein xsd:date sein."@de ;
  sh:message "[PART-043] endDate must be an xsd:date."@en ;
.

conx-part-sh:DateOrderPropertyShape
  a sh:PropertyShape ;
  sh:path conx-part:startDate ;
  sh:lessThanOrEquals conx-part:endDate ;
  sh:severity sh:Violation ;
  sh:message "[PART-044] startDate darf nicht nach endDate liegen."@de ;
  sh:message "[PART-044] startDate must not be later than endDate."@en ;
.

## Optional navigation from a context; context remains explicitly required.

conx-part-sh:HasParticipationShape
  a sh:NodeShape ;
  sh:targetSubjectsOf conx-part:hasParticipation ;
  sh:property [
    sh:path conx-part:hasParticipation ;
    sh:nodeKind sh:IRI ;
    sh:node conx-part-sh:ParticipationShape ;
    sh:message "[PART-060] hasParticipation muss auf eine gültige Participation-IRI verweisen."@de ;
    sh:message "[PART-060] hasParticipation must reference a valid Participation IRI."@en ;
  ] ;
  sh:sparql [
    sh:message "[PART-061] Der hasContext-Wert der verknüpften Participation muss das Ausgangsobjekt sein."@de ;
    sh:message "[PART-061] The linked Participation must explicitly identify the source resource as its context."@en ;
    sh:select """
      SELECT $this ?value WHERE {
        $this <https://www.construct-x.org/ontology/participation#hasParticipation> ?value .
        FILTER NOT EXISTS {
          ?value <https://www.construct-x.org/ontology/participation#hasContext> $this .
        }
      }
    """ ;
  ] ;
.
