@prefix ex: <https://example.org/participation-navigation/> .
@prefix part: <https://www.construct-x.org/ontology/participation#> .
@prefix agent: <https://www.construct-x.org/ontology/agent#> .
@prefix role: <https://www.construct-x.org/vocab/participation-role#> .

# Wrong target and a participation belonging to a different context.
ex:contract part:hasParticipation ex:supplier, ex:participation .
ex:participation a part:Participation ;
    part:hasParticipant ex:supplier ; part:hasRole role:SupplierRole ;
    part:hasContext ex:other-contract .
ex:supplier a agent:Agent .
