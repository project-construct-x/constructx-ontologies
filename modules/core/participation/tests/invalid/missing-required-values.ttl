@prefix conx-agent: <https://www.construct-x.org/ontology/agent#> .
@prefix conx-part: <https://www.construct-x.org/ontology/participation#> .
@prefix part-role: <https://www.construct-x.org/vocab/participation-role#> .
@prefix ex: <https://example.org/id/> .

ex:agent-a a conx-agent:Agent .

ex:missing-participant
  a conx-part:Participation ;
  conx-part:role part-role:ClientRole ;
  conx-part:context ex:context-a ;
.

ex:missing-role
  a conx-part:Participation ;
  conx-part:participant ex:agent-a ;
  conx-part:context ex:context-b ;
.

ex:missing-context
  a conx-part:Participation ;
  conx-part:participant ex:agent-a ;
  conx-part:role part-role:SupplierRole ;
.
