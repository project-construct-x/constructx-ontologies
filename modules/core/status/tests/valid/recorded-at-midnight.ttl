@prefix s: <https://www.construct-x.org/ontology/status#> .
@prefix kind: <https://www.construct-x.org/vocab/status-kind#> .
@prefix value: <https://www.construct-x.org/vocab/status-value#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/status/> .

# The recording instant is 2027-01-01T00:00:00Z; its spelling is preserved.
ex:delivery s:hasStatus ex:s1 .
ex:s1 a s:StatusAssignment ;
  s:hasStatusKind kind:TransportStatus ;
  s:hasStatusValue value:InProgress ;
  s:referenceDate "2026-12-31"^^xsd:date ;
  s:referenceTime "23:59:00Z"^^xsd:time ;
  s:recordedAt "2026-12-31T24:00:00Z"^^xsd:dateTime .
