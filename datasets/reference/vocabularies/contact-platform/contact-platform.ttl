contact-platform:linkedin
  a conx-contact:ContactPlatform, skos:Concept ;
  skos:definition "LinkedIn als Plattform fuer berufliche Profile oder Nachrichtenkontakte."@de ;
  skos:definition "LinkedIn as a platform for professional profiles or messaging contacts."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-platform> ;
  skos:notation "linkedin" ;
  skos:prefLabel "LinkedIn"@de ;
  skos:prefLabel "LinkedIn"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-platform> ;
.

