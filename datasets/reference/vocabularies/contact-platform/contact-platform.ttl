  dcterms:title "Construct-X Contact Platforms"@en ;
  dcterms:title "Construct-X Kontaktplattformen"@de ;
  schema:version "0.1.0" ;
  vann:preferredNamespacePrefix "contact-platform" ;
  vann:preferredNamespaceUri "https://www.construct-x.org/vocab/contact-platform#" ;
  owl:versionIRI <https://www.construct-x.org/vocab/contact-platform/0.1.0> ;
