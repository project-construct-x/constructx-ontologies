          schema:name "Ruhr University Bochum" ;
        ] ;
      schema:name "Sven Zentgraf" ;
    ] ;
  dcterms:description "Kontrolliertes Construct-X-Startvokabular fuer Plattformen von Social-, Messenger- und Webkontaktmethoden."@de ;
  dcterms:description "Controlled Construct-X initial vocabulary for platforms of social, messenger, and web contact methods."@en ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:modified "2026-08-27"^^xsd:date ;
