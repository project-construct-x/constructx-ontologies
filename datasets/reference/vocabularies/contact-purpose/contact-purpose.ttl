    ] ;
  dcterms:description "Kontrolliertes Construct-X-Referenzvokabular fuer fachliche Zwecke von Kontaktpunkten."@de ;
  dcterms:description "Controlled Construct-X reference vocabulary for business purposes of contact points."@en ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:modified "2026-08-27"^^xsd:date ;
