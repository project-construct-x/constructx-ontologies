  skos:prefLabel "Vertrieb"@de ;
  skos:prefLabel "Sales"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
.

contact-purpose:technical
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer technische Rueckfragen oder Abstimmungen."@de ;
  skos:definition "Contact point for technical questions or coordination."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
  skos:notation "technical" ;
  skos:prefLabel "Technisch"@de ;
  skos:prefLabel "Technical"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
.

contact-purpose:emergency
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer Notfaelle, Eskalationen oder dringende Stoerungen."@de ;
  skos:definition "Contact point for emergencies, escalations, or urgent incidents."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
  skos:notation "emergency" ;
  skos:prefLabel "Notfall"@de ;
  skos:prefLabel "Emergency"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
