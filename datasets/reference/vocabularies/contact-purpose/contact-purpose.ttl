  dcterms:title "Construct-X Contact Purposes"@en ;
  dcterms:title "Construct-X Kontaktzwecke"@de ;
  schema:version "0.1.0" ;
  vann:preferredNamespacePrefix "contact-purpose" ;
  vann:preferredNamespaceUri "https://www.construct-x.org/vocab/contact-purpose#" ;
