contact-purpose:general
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer allgemeine Kontaktaufnahme ohne spezifischeren Zweck."@de ;
  skos:definition "Contact point for general contact without a more specific purpose."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
  skos:notation "general" ;
  skos:prefLabel "Allgemein"@de ;
  skos:prefLabel "General"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
.

contact-purpose:delivery
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer Lieferung, Warenannahme oder Zustellung."@de ;
  skos:definition "Contact point for delivery, goods receipt, or dispatch."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
  skos:notation "delivery" ;
  skos:prefLabel "Lieferung"@de ;
  skos:prefLabel "Delivery"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
.

contact-purpose:billing
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer Rechnungen, Zahlungen oder kaufmaennische Klaerung."@de ;
  skos:definition "Contact point for invoices, payments, or commercial clarification."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
  skos:notation "billing" ;
  skos:prefLabel "Rechnung"@de ;
  skos:prefLabel "Billing"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
.

contact-purpose:support
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer Support oder Serviceanfragen."@de ;
  skos:definition "Contact point for support or service requests."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
  skos:notation "support" ;
  skos:prefLabel "Support"@de ;
  skos:prefLabel "Support"@en ;
  skos:topConceptOf <https://www.construct-x.org/vocab/contact-purpose> ;
.

contact-purpose:sales
  a conx-contact:ContactPurpose, skos:Concept ;
  skos:definition "Kontaktpunkt fuer Vertrieb, Angebot oder Verkaufskommunikation."@de ;
  skos:definition "Contact point for sales, quotation, or sales communication."@en ;
  skos:inScheme <https://www.construct-x.org/vocab/contact-purpose> ;
